{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "decision-entry",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "date", "context", "decision", "alternatives", "rationale", "consequences", "confidence", "tags", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^dec-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "context": { "type": "string", "minLength": 4 },
    "decision": { "type": "string", "minLength": 4 },
    "alternatives": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rationale": { "type": "string", "minLength": 10 },
    "consequences": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
    "tags": { "type": "array", "minItems": 2, "maxItems": 6, "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "status": { "type": "string", "enum": ["proposed", "accepted", "rejected", "superseded", "deprecated"] },
    "supersedes": { "type": "string" }
  }
}
