{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "sop-entry",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "domain", "name", "version", "last_updated", "trigger", "estimated_time"],
  "properties": {
    "id": { "type": "string", "pattern": "^sop-[a-z0-9]+(-[a-z0-9]+)+$" },
    "domain": { "type": "string", "enum": ["coding", "research", "ops", "review"] },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "last_updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "trigger": { "type": "string", "minLength": 4 },
    "estimated_time": { "type": "string", "minLength": 2 }
  }
}
