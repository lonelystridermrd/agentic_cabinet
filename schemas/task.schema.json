{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "task-card",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "title", "status", "priority", "created", "updated", "domain", "subtasks"],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 2 },
    "status": { "type": "string", "enum": ["backlog", "in_progress", "blocked", "done", "cancelled"] },
    "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
    "created": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "updated": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "domain": { "type": "string", "minLength": 2 },
    "related_decisions": { "type": "array", "items": { "type": "string" } },
    "related_experiences": { "type": "array", "items": { "type": "string" } },
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^\\[[ xX]\\] .+" }
    }
  }
}
